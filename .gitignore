# Segredos e ambiente local (NUNCA versionar)
.env
*.jks
*.keystore
key.properties

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Flutter / Dart (as pastas android/ e ios/ são geradas por `flutter create`; ver README)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
android/
ios/
.idea/
.vscode/
*.iml
.DS_Store

# APK gerado e hashes (distribuídos pelo painel, nunca versionados)
dist/

# Configuração do Firebase do projeto (baixada do console; copiada para android/app pelo tool/apply_platform_config.py)
firebase/google-services.json
firebase/GoogleService-Info.plist
# Chave de conta de serviço (acesso total de leitura ao banco: NUNCA versionar)
firebase/*-firebase-adminsdk-*.json
firebase/chave-servico.json
